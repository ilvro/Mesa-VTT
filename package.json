{
  "name": "mesa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#mesa": "./vendor/mesa-core/index.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5195 --strictPort",
    "dev:mesa": "MESA_DEV_PREFIX=/Mesa/ vite --host 127.0.0.1 --port 5195 --strictPort",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "desktop:prep": "node scripts/build-desktop.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.ts && tauri build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.58.2",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
